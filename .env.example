# Database connection (Vercel Postgres / Neon)
POSTGRES_URL=

# Secret for authenticating cron job requests (set in Vercel dashboard)
CRON_SECRET=

# Sleeper league ID for the current season
SLEEPER_LEAGUE_ID=

# Draft date for preseason countdown (ISO 8601 format, optional)
# Example: 2026-05-06T20:00:00-04:00
NEXT_PUBLIC_DRAFT_DATE=

# Anthropic API key for the weekly hub content generator (optional). When unset,
# the generate-content cron falls back to the deterministic site-voice templates.
ANTHROPIC_API_KEY=

# Model for hub content generation (optional; defaults to a current Sonnet-tier model)
CONTENT_MODEL=
